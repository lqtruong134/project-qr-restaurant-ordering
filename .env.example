# Generated by pnpm setup. Local development only. Never commit .env.
POSTGRES_USER=thesis
POSTGRES_DB=qr_restaurant_ordering
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5433
DATABASE_URL=postgresql://thesis:CHANGE_ME@127.0.0.1:5433/qr_restaurant_ordering
API_HOST=127.0.0.1
API_PORT=4000
WEB_PORT=3000
API_BASE_URL=http://127.0.0.1:4000

# Temporary login attempt window in seconds (1..86400).
LOGIN_WINDOW_SECONDS=60

# Optional private bank evidence directory. Relative to apps/api; keep outside public/.
PAYMENT_PROOF_DIR=../../var/payment-proofs

# payOS: backend only. Never use NEXT_PUBLIC_ for credentials.
# Set these privately in .env or the deployment secret manager.
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=
# Optional while local; public HTTPS required before registering webhook.
PAYOS_WEBHOOK_URL=

# Menu assistant foundation: OFF by default. MOCK is an explicit deterministic fixture.
# CUSTOM requires a server-injected provider; no HTTP/model client is included.
MENU_ASSISTANT_MODE=OFF
MENU_ASSISTANT_TIMEOUT_MS=8000
MENU_ASSISTANT_RATE_LIMIT=6
MENU_ASSISTANT_WINDOW_MS=60000
MENU_ASSISTANT_MAX_IN_FLIGHT=4
