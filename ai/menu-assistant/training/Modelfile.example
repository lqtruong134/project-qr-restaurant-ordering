# Run only after exporting and checking the merged model on the same held-out cases.
FROM ./merged-q4_k_m.gguf
PARAMETER num_ctx 4096
PARAMETER num_predict 512
PARAMETER temperature 0
PARAMETER seed 3407
PARAMETER stop "<|im_end|>"
# The application supplies assistantSystemPolicy and runtime menu context per request.
# Verify the imported Qwen3 template/EOS and thinking metadata with ollama show.
# The future API request must send format: assistantDecisionSchema and think: false.
# This file imports merged weights. It does not import a LoRA adapter.
