{
  "name": "qr-ordering-thesis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/run.mjs dev",
    "db:up": "node scripts/run.mjs db-up",
    "db:down": "node scripts/run.mjs db-down",
    "db:check": "node scripts/run.mjs db-check",
    "db:migrate": "node scripts/run.mjs migrate",
    "db:seed": "node scripts/run.mjs seed",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "test:integration": "node scripts/run.mjs integration",
    "build": "pnpm --filter @thesis/web build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:e2e": "node scripts/run.mjs e2e",
    "db:generate": "node scripts/run.mjs generate",
    "docs:database": "node scripts/run.mjs docs",
    "demo:rehearse": "node scripts/run.mjs rehearsal",
    "test:coverage": "node scripts/run.mjs coverage",
    "format": "prettier --write \"apps/**/*.{ts,tsx,mjs,js,css}\" \"packages/**/src/**/*.{ts,tsx}\" \"scripts/*.{ts,mjs}\" \"deploy/**/*.mjs\" \"tests/**/*.{ts,tsx}\" \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,mjs,js,css}\" \"packages/**/src/**/*.{ts,tsx}\" \"scripts/*.{ts,mjs}\" \"deploy/**/*.mjs\" \"tests/**/*.{ts,tsx}\" \"*.{ts,mjs,json}\"",
    "db:reset-demo": "node scripts/run.mjs reset-demo",
    "db:seed:core": "node scripts/run.mjs seed-core",
    "dev:lan": "node scripts/run.mjs dev-lan",
    "db:seed:workforce": "node --env-file=.env --import tsx scripts/seed-workforce.ts",
    "payos:check": "node --env-file=.env --import tsx scripts/payos-config.ts check",
    "payos:register-webhook": "node --env-file=.env --import tsx scripts/payos-config.ts register-webhook",
    "ai:data:validate": "node --import tsx scripts/menu-assistant-data.ts validate",
    "ai:evaluate": "node --import tsx scripts/menu-assistant-data.ts evaluate",
    "deploy": "node scripts/deploy.mjs",
    "test:deploy": "node --test scripts/deploy.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "prettier": "3.9.6",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.0"
  }
}
