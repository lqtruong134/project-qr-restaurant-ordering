# syntax=docker/dockerfile:1
ARG NODE_VERSION=24.21.0

FROM node:${NODE_VERSION}-bookworm-slim AS builder
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global pnpm@12.3.4
WORKDIR /workspace
ENV NEXT_TELEMETRY_DISABLED=1 \
    API_BASE_URL=http://api:4000 \
    NODE_OPTIONS=--max-old-space-size=3072
COPY . .
RUN pnpm install --frozen-lockfile
# Includes prepare-docs: Swagger assets are built from tracked documentation.
RUN pnpm --filter @thesis/web build

FROM node:${NODE_VERSION}-bookworm-slim AS runtime
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin app
WORKDIR /app
COPY --from=builder /workspace/apps/web/.next/standalone/ ./
COPY --from=builder /workspace/apps/web/.next/static/ ./apps/web/.next/static/
COPY --from=builder /workspace/apps/web/public/ ./apps/web/public/
USER 10001:10001
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD ["node", "--input-type=module", "-e", "const r=await fetch('http://127.0.0.1:3000/',{signal:AbortSignal.timeout(4000)});if(!r.ok)process.exit(1)"]
CMD ["node", "apps/web/server.js"]
