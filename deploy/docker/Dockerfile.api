# syntax=docker/dockerfile:1
ARG NODE_VERSION=24.21.0

FROM node:${NODE_VERSION}-bookworm-slim AS toolchain
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global pnpm@12.3.4
WORKDIR /workspace
ENV NEXT_TELEMETRY_DISABLED=1

FROM toolchain AS dependencies
COPY . .
# Keep completed downloads across failed/repeated builds. Copy packages out of the
# mounted store so later stages never depend on the cache remaining mounted.
RUN --mount=type=cache,id=qtruongres-pnpm-v12,target=/pnpm/store,sharing=locked \
    pnpm_config_network_concurrency=4 \
    pnpm_config_fetch_timeout=300000 \
    pnpm_config_fetch_retries=3 \
    pnpm_config_fetch_retry_factor=2 \
    pnpm_config_fetch_retry_mintimeout=10000 \
    pnpm_config_fetch_retry_maxtimeout=60000 \
    pnpm_config_package_import_method=copy \
    pnpm install --store-dir=/pnpm/store --frozen-lockfile
FROM dependencies AS source
# COPY preserves restrictive host modes. Normalize build artifacts before the
# non-root maintenance stage: directories need traversal, files only need reading.
RUN chmod 0755 /workspace /workspace/packages /workspace/packages/database /workspace/packages/database/prisma \
    && find packages/database/prisma/migrations -type d -exec chmod 0755 {} + \
    && find packages/database/prisma/migrations -type f -exec chmod 0644 {} +
# Prisma generate reads config but does not connect to this placeholder database.
RUN DATABASE_URL=postgresql://localhost/build pnpm --filter @thesis/database exec prisma generate

# Explicit administrative image. Compose supplies migrate deploy when requested;
# normal application startup never migrates or seeds the database.
FROM source AS maintenance
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin app
# Explicit maintenance scripts also import workspace source/dependencies. COPY
# may preserve mode 600; retain root ownership and grant read/traverse to app only.
RUN chown -R 0:10001 /workspace \
    && chmod -R u=rwX,g=rX,o= /workspace
ENV NODE_ENV=production
USER 10001:10001
CMD ["node", "--version"]

FROM source AS production-dependencies
# deploy can fetch on a cache miss too; use the same store and bounded network policy.
RUN --mount=type=cache,id=qtruongres-pnpm-v12,target=/pnpm/store,sharing=locked \
    pnpm_config_network_concurrency=4 \
    pnpm_config_fetch_timeout=300000 \
    pnpm_config_fetch_retries=3 \
    pnpm_config_fetch_retry_factor=2 \
    pnpm_config_fetch_retry_mintimeout=10000 \
    pnpm_config_fetch_retry_maxtimeout=60000 \
    pnpm_config_package_import_method=copy \
    pnpm --filter @thesis/api deploy --store-dir=/pnpm/store --prod --legacy --frozen-lockfile /opt/api
FROM node:${NODE_VERSION}-bookworm-slim AS runtime
ENV NODE_ENV=production \
    API_HOST=0.0.0.0 \
    API_PORT=4000 \
    MENU_UPLOAD_DIR=/data/menu-images \
    PAYMENT_PROOF_DIR=/data/payment-proofs \
    PAYOS_ORDER_CODE_STORE=/data/payos-state/order-codes.sqlite \
    TSX_DISABLE_CACHE=1 \
    TSX_TSCONFIG_PATH=/app/tsconfig.runtime.json
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin app \
    && mkdir -p /data/menu-images /data/payment-proofs \
    && chown -R 10001:10001 /data
WORKDIR /app
COPY --chown=0:10001 --from=production-dependencies /opt/api/ ./
# Copy between stages: deploy may already hardlink these files when .git is absent.
# Explicit copies also cover a Git checkout where generated files are excluded from packing.
COPY --chown=0:10001 --from=source /workspace/packages/database/generated/ ./node_modules/@thesis/database/generated/
COPY --chown=0:10001 --from=source /workspace/packages/database/resources/ ./node_modules/@thesis/database/resources/
COPY --chown=0:10001 --from=source /workspace/packages/config/tsconfig.base.json ./tsconfig.runtime.json
COPY --chown=0:10001 --from=source /workspace/deploy/runtime-files.mjs ./deploy/runtime-files.mjs
# pnpm deploy and COPY preserve host modes (including 600/700). Keep code
# root-owned and group-readable; preserve executable bits for native tools.
RUN chown 0:10001 /app \
    && chmod -R u=rwX,g=rX,o= /app
USER 10001:10001
EXPOSE 4000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD ["node", "--input-type=module", "-e", "const r=await fetch('http://127.0.0.1:4000/health/ready',{signal:AbortSignal.timeout(4000)});if(!r.ok)process.exit(1)"]
CMD ["node", "--import", "tsx", "src/server.ts"]
