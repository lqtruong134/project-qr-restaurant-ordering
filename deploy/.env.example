# qtruongres production configuration TEMPLATE. Copy privately to deploy/.env.production.
# Never load the development .env for production. No live credentials belong in Git.
QTRUONGRES_PROJECT_NAME=qtruongres
PUBLIC_APP_URL=https://qtruongres.example
QTRUONGRES_CADDY_PORT=8088

# New deployment: generate a long password privately. URL-encode it in DATABASE_URL.
POSTGRES_USER=qtruongres
POSTGRES_DB=qtruongres
POSTGRES_PASSWORD=REPLACE_WITH_PRIVATE_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://qtruongres:REPLACE_WITH_PRIVATE_RANDOM_DATABASE_PASSWORD@postgres:5432/qtruongres

# Importing an existing database: preserve its ORIGINAL AUTH_SECRET and tenant UUID.
# AUTH_SECRET also decrypts stored table access codes; do not replace it during import.
AUTH_SECRET=REPLACE_WITH_ORIGINAL_AUTH_SECRET_FOR_IMPORTED_DATA
RESTAURANT_ID=REPLACE_WITH_EXISTING_RESTAURANT_UUID

# Exact origin is derived from PUBLIC_APP_URL unless deliberately overridden here.
# APP_ORIGINS=https://qtruongres.example
LOGIN_LIMIT=5
LOGIN_WINDOW_SECONDS=60

# Keep these off during initial deployment and automated verification.
MENU_ASSISTANT_MODE=OFF
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=
PAYOS_WEBHOOK_URL=

# Scoped private proxy addresses; change both CIDR and corresponding IP if a VPN conflicts.
QTRUONGRES_APP_SUBNET=172.30.80.0/24
QTRUONGRES_CADDY_IP=172.30.80.10
QTRUONGRES_TUNNEL_SUBNET=172.30.81.0/24
QTRUONGRES_CLOUDFLARED_IP=172.30.81.10

# Optional remotely managed Named Tunnel only after account/domain setup by the operator.
# File contains the private connector token; never paste the token into this template.
CLOUDFLARED_TOKEN_FILE=./var/deploy/cloudflared-token
QTRUONGRES_TUNNEL_UID=1000
QTRUONGRES_TUNNEL_GID=1000

# Image overrides can pin a validated digest; defaults are in compose.production.yaml.
# QTRUONGRES_API_IMAGE=qtruongres-api:local
# QTRUONGRES_WEB_IMAGE=qtruongres-web:local
# QTRUONGRES_MAINTENANCE_IMAGE=qtruongres-maintenance:local
# Caddy is built locally to remove an unnecessary low-port binary capability.
# QTRUONGRES_CADDY_IMAGE=qtruongres-caddy:local
# Keep the upstream base pinned when deliberately upgrading the custom image.
# QTRUONGRES_CADDY_BASE_IMAGE=caddy:2.11.7-alpine@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f

# Optional private MB recipient binding. Exact clientId, restaurantId, bankBin and accountNumber.
# No automatic trust is granted by diagnostic output. Leave empty to keep strict CREATE/VA matching.
PAYOS_RECIPIENT_BINDING=
